rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seuls les comptes listés ici peuvent lire et modifier les chantiers.
    // Remplacez l'adresse par celle du compte créé dans Firebase Authentication.
    match /chantiers/{chantierId} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['contact@es-autos.fr'];
    }
    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
